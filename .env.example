# Salin ke .env.local (jangan di-commit). Untuk produksi, isi di Vercel > Settings > Environment Variables.

# Turso. Untuk dev lokal tanpa akun Turso, pakai file SQLite lokal:
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Kunci penandatangan sesi. Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Satu-satunya Admin (lihat docs/adr/0001-admin-dari-env.md). Simpan hash bcrypt, bukan password.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Google SSO (lihat docs/adr/0002-google-sso.md). Buat di Google Cloud Console > APIs & Services >
# Credentials > Create Credentials > OAuth client ID > Web application.
# Authorized redirect URI: https://<domain>/api/auth/google/callback (dan http://localhost:3000/... untuk dev).
# Kalau kosong, tombol "Masuk dengan Google" tidak berfungsi dan hanya login nomor telepon yang jalan.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
